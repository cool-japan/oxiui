FROM rust:slim
WORKDIR /oxiui
COPY . .
# No apt-get install — must build with zero system deps
RUN cargo build -p oxiui --no-default-features --features software 2>&1
RUN bash scripts/ffi-audit.sh
# Headless smoke test (M5 gate): render a frame with no window/GPU/display and
# assert it contains visible (non-background) content. Fails the image build
# (non-zero exit) if the software render path is broken.
RUN cargo run -p oxiui --example hello_headless --no-default-features --features software
